export async function POST(req: Request) {
  try {
    // Optional parameter from client: can query live Internet Archive search API
    let liveMovies: MediaItem[] = [];

    try {
      const iaUrl = 'https://archive.org/advancedsearch.php?q=collection:(feature_films)+AND+mediatype:(movies)&fl[]=identifier,title,description,year,genre,downloads&sort[]=downloads+desc&rows=6&page=1&output=json';
      const res = await fetch(iaUrl, { next: { revalidate: 3600 } });
      if (res.ok) {
        const data = await res.json();
        const docs = data.response?.docs || [];
        liveMovies = docs.map((doc: any, index: number) => {
          const id = `ia-${doc.identifier}`;
          return {
            id,
            title: doc.title || 'Película Clásica',
            type: 'movie' as const,
            genre: Array.isArray(doc.genre) ? doc.genre : [doc.genre || 'Clásico'],
            year: parseInt(doc.year, 10) || 1950,
            rating: '16+',
            duration: '1h 30m',
            description: doc.description || 'Película histórica de dominio público preservada por Internet Archive.',
            thumbnail: `https://archive.org/services/img/${doc.identifier}`,
            backdrop: `https://archive.org/services/img/${doc.identifier}`,
            videoUrl: `https://archive.org/download/${doc.identifier}/${doc.identifier}_512kb.mp4`,
            trailerUrl: `https://archive.org/download/${doc.identifier}/${doc.identifier}_512kb.mp4`,
            match: 90 + (index % 10),
            isNew: true,
          };
        });
      }
    } catch {
      // If live Internet Archive search rate-limits or fails, the verified verified catalog provides 100% guarantee
    }

    // Combine verified open movie collection with any live query items
    const combined = [...VERIFIED_OPEN_MOVIES, ...liveMovies];

    return NextResponse.json({
      success: true,
      message: `Se han sincronizado ${combined.length} películas legales con éxito.`,
      movies: combined,
      timestamp: new Date().toISOString(),
    });
  } catch (error: any) {
    return NextResponse.json(
      { success: false, error: error.message || 'Error al sincronizar catálogo' },
      { status: 500 }
    );
  }
}

export async function GET() {
  return NextResponse.json({
    status: 'online',
    availableSources: ['Internet Archive (Dominio Público)', 'Blender Open Projects (Creative Commons)', 'TMDB API (Metadatos)'],
    verifiedCount: VERIFIED_OPEN_MOVIES.length,
  });
}
