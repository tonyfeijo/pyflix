# Opcional: Clave API de The Movie Database (TMDB)
# Si no se define, PyFlix funciona al 100% con los datos mock locales y vídeos Creative Commons integrados.
NEXT_PUBLIC_TMDB_API_KEY=tu_api_key_de_tmdb_aqui

# Jellyfin (solo servidor: NO uses NEXT_PUBLIC_ en estas variables)
# URL pública de tu servidor Jellyfin, con HTTPS y sin barra final.
# Ejemplo: https://jellyfin.tudominio.com
JELLYFIN_URL=

# API key creada en Jellyfin: Dashboard -> API Keys -> +
JELLYFIN_API_KEY=
